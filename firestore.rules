rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        (
          request.auth.token.email == 'rohantmr.lover@gmail.com' ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidEvent(data) {
      return data.keys().hasAll([
          'title', 'category', 'description', 'venue', 'eventDate',
          'startTime', 'lateCutoffTime', 'cutoffTimestamp', 'status',
          'createdByUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'category', 'description', 'venue', 'eventDate',
          'startTime', 'lateCutoffTime', 'cutoffTimestamp', 'status',
          'createdByUid', 'createdAt', 'updatedAt',
          'departmentLabel', 'departmentPresets', 'consentText',
          'facilitators', 'principalName'
        ]) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.description is string && data.description.size() <= 500 &&
        data.venue is string && data.venue.size() >= 1 && data.venue.size() <= 120 &&
        data.eventDate is string && data.eventDate.size() == 10 && data.eventDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.startTime is string && data.startTime.size() == 5 && data.startTime.matches('^[0-9]{2}:[0-9]{2}$') &&
        data.lateCutoffTime is string && data.lateCutoffTime.size() == 5 && data.lateCutoffTime.matches('^[0-9]{2}:[0-9]{2}$') &&
        data.cutoffTimestamp is timestamp &&
        data.status in ['active', 'closed'] &&
        isValidId(data.createdByUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (!('departmentLabel' in data) || (data.departmentLabel is string && data.departmentLabel.size() <= 80)) &&
        (!('departmentPresets' in data) || (data.departmentPresets is string && data.departmentPresets.size() <= 300)) &&
        (!('consentText' in data) || (data.consentText is string && data.consentText.size() <= 400)) &&
        (!('facilitators' in data) || (data.facilitators is string && data.facilitators.size() <= 200)) &&
        (!('principalName' in data) || (data.principalName is string && data.principalName.size() <= 120));
    }

    function isValidAttendance(data) {
      return data.keys().hasAll([
          'eventId', 'eventName', 'fullName', 'classDepartment',
          'photoDataUrl', 'photoConsent', 'attendanceDate',
          'checkInTime', 'serverTimestamp', 'status', 'lateExcuse'
        ]) &&
        data.keys().hasOnly([
          'eventId', 'eventName', 'fullName', 'classDepartment',
          'photoDataUrl', 'photoConsent', 'attendanceDate',
          'checkInTime', 'serverTimestamp', 'status', 'lateExcuse'
        ]) &&
        isValidId(data.eventId) &&
        data.eventName is string && data.eventName.size() >= 2 && data.eventName.size() <= 140 &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
        data.classDepartment is string && data.classDepartment.size() >= 1 && data.classDepartment.size() <= 100 &&
        data.photoDataUrl is string && data.photoDataUrl.size() >= 30 && data.photoDataUrl.size() <= 250000 &&
        (
          data.photoDataUrl[0:23] == 'data:image/jpeg;base64,' ||
          data.photoDataUrl[0:22] == 'data:image/png;base64,' ||
          data.photoDataUrl[0:23] == 'data:image/webp;base64,'
        ) &&
        data.photoConsent is bool &&
        data.attendanceDate is string && data.attendanceDate.size() == 10 && data.attendanceDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.checkInTime is string && data.checkInTime.size() >= 4 && data.checkInTime.size() <= 32 &&
        data.serverTimestamp is timestamp &&
        data.status in ['On Time', 'Late'] &&
        data.lateExcuse is string && data.lateExcuse.size() <= 300 &&
        (data.status == 'On Time' || data.lateExcuse.size() >= 3);
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'addedByUid', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'addedByUid', 'createdAt']) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        isValidId(data.addedByUid) &&
        data.createdAt is timestamp;
    }

    function isValidDashboardSetting(data) {
      return data.keys().hasAll(['backgroundDataUrl', 'updatedByUid', 'updatedAt']) &&
        data.keys().hasOnly(['backgroundDataUrl', 'updatedByUid', 'updatedAt']) &&
        data.backgroundDataUrl is string &&
        data.backgroundDataUrl.size() >= 30 &&
        data.backgroundDataUrl.size() <= 450000 &&
        data.backgroundDataUrl[0:23] == 'data:image/jpeg;base64,' &&
        isValidId(data.updatedByUid) &&
        data.updatedAt is timestamp;
    }

    function isValidBranding(data) {
      return data.keys().hasAll(['organizationName', 'logoDataUrl', 'updatedByUid', 'updatedAt']) &&
        data.keys().hasOnly(['organizationName', 'logoDataUrl', 'updatedByUid', 'updatedAt']) &&
        data.organizationName is string && data.organizationName.size() <= 120 &&
        data.logoDataUrl is string && data.logoDataUrl.size() <= 350000 &&
        (
          data.logoDataUrl.size() == 0 ||
          (
            data.logoDataUrl.size() >= 30 &&
            (
              data.logoDataUrl[0:22] == 'data:image/png;base64,' ||
              data.logoDataUrl[0:23] == 'data:image/jpeg;base64,' ||
              data.logoDataUrl[0:23] == 'data:image/webp;base64,'
            )
          )
        ) &&
        isValidId(data.updatedByUid) &&
        data.updatedAt is timestamp;
    }

    match /events/{eventId} {
      allow get: if isValidId(eventId) && (existing().status == 'active' || isAdmin());
      allow list: if existing().status == 'active' || isAdmin();
      allow create: if isAdmin() &&
        isValidId(eventId) &&
        isValidEvent(incoming()) &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(eventId) &&
        isValidEvent(incoming()) &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'category', 'description', 'venue', 'eventDate',
          'startTime', 'lateCutoffTime', 'cutoffTimestamp', 'status', 'updatedAt',
          'departmentLabel', 'departmentPresets', 'consentText',
          'facilitators', 'principalName'
        ]);
      allow delete: if isAdmin() && isValidId(eventId);
    }

    match /attendances/{attendanceId} {
      allow get: if isAdmin() && isValidId(attendanceId);
      allow list: if isAdmin();
      allow create: if isValidId(attendanceId) &&
        isValidAttendance(incoming()) &&
        incoming().photoConsent == true &&
        incoming().serverTimestamp == request.time &&
        exists(/databases/$(database)/documents/events/$(incoming().eventId)) &&
        get(/databases/$(database)/documents/events/$(incoming().eventId)).data.status == 'active' &&
        incoming().eventName == get(/databases/$(database)/documents/events/$(incoming().eventId)).data.title;
      allow update: if isAdmin() &&
        isValidId(attendanceId) &&
        isValidAttendance(incoming()) &&
        incoming().eventId == existing().eventId &&
        incoming().serverTimestamp == existing().serverTimestamp &&
        incoming().photoDataUrl == existing().photoDataUrl &&
        incoming().photoConsent == existing().photoConsent &&
        incoming().attendanceDate == existing().attendanceDate &&
        incoming().checkInTime == existing().checkInTime &&
        incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'classDepartment', 'status', 'lateExcuse']);
      allow delete: if isAdmin() && isValidId(attendanceId);
    }

    match /admins/{adminUid} {
      allow get: if isAdmin() && isValidId(adminUid);
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        isValidId(adminUid) &&
        isValidAdminUser(incoming()) &&
        incoming().uid == adminUid &&
        incoming().addedByUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminUid) && adminUid != request.auth.uid;
    }

    match /dashboardSettings/{settingId} {
      allow get: if isAdmin() && isValidId(settingId);
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        isValidId(settingId) &&
        isValidDashboardSetting(incoming()) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(settingId) &&
        isValidDashboardSetting(incoming()) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['backgroundDataUrl', 'updatedByUid', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(settingId);
    }

    match /branding/{brandingId} {
      allow get: if isValidId(brandingId);
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        isValidId(brandingId) &&
        isValidBranding(incoming()) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(brandingId) &&
        isValidBranding(incoming()) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['organizationName', 'logoDataUrl', 'updatedByUid', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(brandingId);
    }
  }
}
